{
  "name": "codex-auto-approve",
  "displayName": "Auto Approve (Codex & Copilot)",
  "description": "Automatically approves matching Codex and GitHub Copilot prompts in VS Code on Windows.",
  "version": "0.3.3",
  "publisher": "local",
  "license": "MIT",
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "codex",
    "copilot",
    "approval",
    "automation"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:codexAutoApprove.enable",
    "onCommand:codexAutoApprove.disable",
    "onCommand:codexAutoApprove.toggle",
    "onCommand:codexAutoApprove.showLogs"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist/**",
    "scripts/**",
    "README.md",
    "README-tw.md",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "codexAutoApprove.enable",
        "title": "Enable",
        "category": "Auto Approve"
      },
      {
        "command": "codexAutoApprove.disable",
        "title": "Disable",
        "category": "Auto Approve"
      },
      {
        "command": "codexAutoApprove.toggle",
        "title": "Toggle",
        "category": "Auto Approve"
      },
      {
        "command": "codexAutoApprove.showLogs",
        "title": "Show Logs",
        "category": "Auto Approve"
      }
    ],
    "configuration": {
      "title": "Auto Approve (Codex & Copilot)",
      "properties": {
        "codexAutoApprove.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for the local approval bridge. When on, enabled providers approve matching prompts automatically."
        },
        "codexAutoApprove.codex.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Approve matching OpenAI Codex prompts when the master switch is on."
        },
        "codexAutoApprove.copilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Approve matching GitHub Copilot Chat/Agent and terminal prompts when the master switch is on."
        },
        "codexAutoApprove.pollInterval": {
          "type": "number",
          "default": 50,
          "minimum": 50,
          "maximum": 5000,
          "description": "Legacy setting retained for compatibility; event-driven versions no longer poll at this interval.",
          "markdownDeprecationMessage": "No longer used. Auto Approve is event-driven starting with version 0.2.0."
        },
        "codexAutoApprove.eventDebounce": {
          "type": "number",
          "default": 10,
          "minimum": 0,
          "maximum": 200,
          "description": "Milliseconds used to combine bursts of Windows accessibility events before scanning."
        },
        "codexAutoApprove.idleScanInterval": {
          "type": "number",
          "default": 1000,
          "minimum": 250,
          "maximum": 5000,
          "description": "Milliseconds between low-frequency safety scans when no accessibility events arrive."
        },
        "codexAutoApprove.onlyWhenCodexVisible": {
          "type": "boolean",
          "default": true,
          "description": "Require a visible Codex accessibility marker before approving Codex prompts."
        },
        "codexAutoApprove.copilot.onlyWhenVisible": {
          "type": "boolean",
          "default": true,
          "description": "Require a visible Copilot accessibility marker before approving Copilot prompts."
        },
        "codexAutoApprove.hostProcessNames": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Code",
            "Code - Insiders",
            "VSCodium",
            "Cursor",
            "Cursor Helper",
            "Windsurf",
            "code-oss"
          ],
          "description": "Host process names whose windows may be scanned and whose accessibility events may wake the bridge."
        },
        "codexAutoApprove.approachLabels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "User approach",
            "Use user approach",
            "使用者方案",
            "使用者方法",
            "使用者做法",
            "用户方案",
            "用户方法",
            "用户做法"
          ],
          "description": "Codex: exact accessible labels that select the preferred approach before approval."
        },
        "codexAutoApprove.approvalLabels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Allow once",
            "Allow",
            "Approve",
            "Agree",
            "Confirm",
            "Yes, proceed",
            "Use this approach",
            "允許一次",
            "允許",
            "核准",
            "同意",
            "確認",
            "是，繼續",
            "使用此方案",
            "使用這個方案",
            "允许一次",
            "允许",
            "批准",
            "同意",
            "确认",
            "是，继续",
            "使用此方案",
            "使用这个方案"
          ],
          "description": "Codex: exact accessible button labels that may be invoked inside a Codex context."
        },
        "codexAutoApprove.codexMarkers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Codex",
            "OpenAI Codex"
          ],
          "description": "Case-insensitive text fragments used to identify the Codex UI context."
        },
        "codexAutoApprove.copilot.approvalLabels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Allow",
            "Allow once",
            "Allow Once",
            "Allow always",
            "Allow Always",
            "Always allow",
            "Always Allow",
            "Allow in this session",
            "Continue",
            "Confirm",
            "Accept",
            "Approve",
            "Yes",
            "Proceed",
            "允許",
            "允許一次",
            "一律允許",
            "總是允許",
            "永遠允許",
            "允許在此工作階段",
            "允許在此工作階段中",
            "繼續",
            "確認",
            "接受",
            "核准",
            "是",
            "继续",
            "允许",
            "允许一次",
            "一律允许",
            "总是允许",
            "永远允许",
            "允许在此会话",
            "允许在此会话中",
            "确认",
            "接受",
            "批准"
          ],
          "description": "Copilot/Cursor: exact accessible labels for Chat/Agent and permission approvals."
        },
        "codexAutoApprove.copilot.terminalLabels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Run",
            "Run command",
            "Run in terminal",
            "Run everything",
            "執行",
            "執行命令",
            "在終端機中執行",
            "全部執行",
            "运行",
            "运行命令",
            "在终端中运行",
            "全部运行"
          ],
          "description": "Copilot/Cursor: exact accessible labels for terminal command execution approvals. Merged with copilot.approvalLabels."
        },
        "codexAutoApprove.copilot.markers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Copilot",
            "GitHub Copilot",
            "Copilot Chat",
            "Cursor",
            "browser state",
            "Executes code",
            "Default permissions",
            "MCP",
            "Computer Use"
          ],
          "description": "Case-insensitive text fragments used to identify Copilot/Cursor permission UI context."
        },
        "codexAutoApprove.cooldown": {
          "type": "number",
          "default": 1500,
          "minimum": 250,
          "maximum": 30000,
          "description": "Milliseconds before the same accessibility element may be triggered again."
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "npm run compile && node --test dist/test/*.test.js",
    "vscode:prepublish": "npm run clean && npm run compile",
    "package": "npx --yes @vscode/vsce package --baseContentUrl https://github.com/local/codex-auto/blob/HEAD --baseImagesUrl https://github.com/local/codex-auto/raw/HEAD"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.96.0",
    "typescript": "^5.7.2"
  }
}
